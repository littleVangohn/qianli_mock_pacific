@echo off
setlocal

rem ---------------------------------------------------------------
rem  RoboMaster local simulator - double-click entry point
rem
rem  Starts EVERYTHING (full chain):
rem    1. InfluxDB
rem    2. RoboMasterEngine (it starts RMServer / AdapterSvr /
rem       RMServerLogClient / Redis)
rem    3. Local hotspot 192.168.137.1 / 192.168.1.2 / 192.168.1.3
rem    4. RMClientDaemon (video: COM5 + VT USB)
rem    5. Official client RoboMasterClient.exe (MQTT broker :3333)
rem    6. Custom client cquqianli_mock in WSL
rem
rem  Order matters: stop ICS -> start engine (grab UDP 62101-62103)
rem  -> restore hotspot. See scripts\start_local_sim.ps1.
rem
rem  Optional args (rarely needed):
rem    start_local_sim.bat -ServicesOnly   only services, no clients
rem    start_local_sim.bat -DryRun         check only, change nothing
rem ---------------------------------------------------------------

net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0scripts\start_local_sim.ps1" %*
set "RC=%errorlevel%"

echo.
if not "%RC%"=="0" echo [ERROR] start_local_sim.ps1 exited with code %RC%
pause
exit /b %RC%
